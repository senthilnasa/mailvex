# Mailvex Environment Configuration Example

# Operational Profile: homelab | standard | cluster
MVX_PROFILE=standard

# App & HTTP Server
MVX_APP_ENV=development
MVX_APP_PORT=8080
MVX_APP_URL=http://localhost:8080
MVX_CONSOLE_URL=http://localhost:3000

# Security & Master Encryption Key (AES-256: 32 bytes base64 encoded or 64-char hex)
# Generate with: openssl rand -base64 32
MVX_MASTER_KEY=bWFpbHZleC1ob21lbGFiLTMyYnl0ZS1tYXN0ZXJrZWs=
MVX_KEK_PROVIDER=env

# Database (MariaDB 11+ / MySQL 8+)
MVX_DB_HOST=127.0.0.1
MVX_DB_PORT=3306
MVX_DB_USER=mailvex
MVX_DB_PASSWORD=mailvex_secret
MVX_DB_NAME=mailvex
MVX_DB_MAX_OPEN_CONNS=25
MVX_DB_MAX_IDLE_CONNS=10

# Redis (Queues, Outbox & Sessions)
MVX_REDIS_ADDR=127.0.0.1:6379
MVX_REDIS_PASSWORD=
MVX_REDIS_DB=0

# SMTP Edge Configuration
MVX_SMTP_SUBMISSION_PORT=587
MVX_SMTP_SMTPS_PORT=465
MVX_SMTP_INBOUND_PORT=25
MVX_SMTP_HOSTNAME=mail.example.com

# System Mail Mode: direct | relay
MVX_SYSTEM_MAIL_MODE=direct
MVX_SYSTEM_MAIL_FROM=system@mail.example.com

# Logging
MVX_LOG_LEVEL=info
MVX_LOG_FORMAT=json
MVX_LOG_REDACT_EMAIL=true
